 {
  "id": "mcs8m.bdash.settings",
  "type": "change",
  "z": "mcs8m.bdash.tab",
  "name": "EDIT SETTINGS HERE",
  "rules": [
   {
    "t": "set",
    "p": "source_names",
    "pt": "flow",
    "tot": "json",
    "to": "{\"1\": \"Input 1\", \"2\": \"Input 2\", \"3\": \"Input 3\", \"4\": \"Input 4\", \"5\": \"Input 5\", \"6\": \"Input 6\", \"7\": \"Input 7\", \"8\": \"Input 8\", \"9\": \"Input 9\", \"10\": \"Input 10\", \"11\": \"Input 11\", \"12\": \"Input 12\", \"13\": \"Input 13\", \"14\": \"Input 14\"}"
   },
   {
    "t": "set",
    "p": "buttons",
    "pt": "flow",
    "tot": "json",
    "to": "[1,2,3,4]"
   },
   {
    "t": "set",
    "p": "bridge_url",
    "pt": "flow",
    "tot": "str",
    "to": "http://127.0.0.1:8765"
   },
   {
    "t": "set",
    "p": "bridge_token",
    "pt": "flow",
    "tot": "str",
    "to": ""
   }
  ],
  "action": "",
  "property": "",
  "from": "",
  "to": "",
  "reg": false,
  "x": 330,
  "y": 100,
  "wires": [
   []
  ],
  "info": "source_names: name shown for each input (1-14).\nbuttons: the source number each of the 4 buttons selects, top to bottom.\nbridge_url: where the MCS-8M bridge runs, e.g. http://127.0.0.1:8765 (same Pi) or http://192.168.1.20:8765.\nbridge_token: only if http.token is set in the bridge's config.json."
 },
