 {
  "id": "mcs8m.bdash.qr",
  "type": "ui_template",
  "z": "mcs8m.bdash.tab",
  "group": "mcs8m.bdash.gc",
  "name": "Dashboard QR code",
  "order": 5,
  "width": "6",
  "height": "6",
  "format": "<div style=\"display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;\">\n    <canvas id=\"qr-code\"></canvas>\n    <div style=\"margin-top:15px;font-weight:bold;\">Scan to control</div>\n    <div id=\"qr-url\" style=\"font-size:0.8em;color:gray;\"></div>\n</div>\n<script src=\"https://cdnjs.cloudflare.com/ajax/libs/qrious/4.0.2/qrious.min.js\"></script>\n<script>\n    (function(scope) {\n        setTimeout(function() {\n            // whatever address this dashboard was opened with, e.g. http://192.168.1.20:1880/ui\n            var url = window.location.origin + window.location.pathname.replace(/\\/$/, '');\n            document.getElementById('qr-url').textContent = url;\n            try {\n                new QRious({ element: document.getElementById('qr-code'), value: url, size: 200, level: 'H' });\n            } catch (e) {\n                document.getElementById('qr-code').outerHTML = '<p>QR library not available (offline?)</p>';\n            }\n        }, 500);\n    })(scope);\n</script>",
  "storeOutMessages": true,
  "fwdInMessages": true,
  "resendOnRefresh": true,
  "templateScope": "local",
  "x": 150,
  "y": 920,
  "wires": [
   []
  ]
 },
