 {
  "id": "mcs8m.bdash.watchdog",
  "type": "function",
  "z": "mcs8m.bdash.tab",
  "name": "Watchdog Logic",
  "func": "const lastResponse = flow.get('last_response_time') || 0;\nconst now = Date.now();\nif (now - lastResponse > 5000) {\n    return { payload: \"OFFLINE\", color: \"red\" };\n} else {\n    return { payload: \"ONLINE\", color: \"green\" };\n}",
  "outputs": 1,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 330,
  "y": 860,
  "wires": [
   [
    "mcs8m.bdash.status"
   ]
  ]
 },
