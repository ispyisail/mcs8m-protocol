[
 {
  "id": "mcs8m.bdash.tab",
  "type": "tab",
  "label": "MCS-8M Dashboard (via bridge)",
  "disabled": false,
  "info": "Phone/tablet dashboard for a Sony MCS-8M, talking to the MCS-8M bridge (bridge/ in the repo)\ninstead of the serial port, so vMix, OBS and Companion can share the switcher.\n\nSetup: start the bridge, then double-click EDIT SETTINGS HERE and set bridge_url (and bridge_token if you set one)."
 },
