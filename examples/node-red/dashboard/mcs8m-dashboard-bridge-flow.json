   ]
  ],
  "func": "// Turns a button ({aux, source}) or a mode choice ({app, mode}) into a POST to the bridge.\nconst base = (flow.get('bridge_url') || 'http://127.0.0.1:8765').replace(/\\/+$/, '');\nconst p = msg.payload || {};\nlet path;\nif (p.aux && p.source) path = `/api/aux/${p.aux}/${p.source}`;\nelse if (p.app && p.mode) path = `/api/mode/${p.app}/${p.mode}`;\nelse return null;\nconst token = flow.get('bridge_token');\nreturn { method: 'POST', url: base + path, payload: '', headers: token ? { Authorization: 'Bearer ' + token } : {} };"
 },
