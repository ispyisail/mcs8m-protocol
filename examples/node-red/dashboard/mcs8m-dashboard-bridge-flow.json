 {
  "id": "mcs8m.bdash.leds",
  "type": "function",
  "z": "mcs8m.bdash.tab",
  "name": "LED & Status Controller",
  "func": "// Lights the LED next to whichever button matches each Aux output's source,\n// and shows the source name. Outputs: Aux1 LEDs 1-4, Aux2 LEDs 1-4, Aux1 name, Aux2 name.\nif (!msg.payload || !msg.payload.aux || !msg.payload.source) return null;\nflow.set(`aux${msg.payload.aux}_source`, msg.payload.source);\nconst src = { 1: flow.get('aux1_source') || 0, 2: flow.get('aux2_source') || 0 };\nconst buttons = flow.get('buttons') || [1, 2, 3, 4];          // set in EDIT SETTINGS HERE\nconst names = flow.get('source_names') || {};\nconst name = s => s ? (names[s] || `Input ${s}`) : '-';\nconst out = [];\nfor (const aux of [1, 2]) for (let i = 0; i < 4; i++) out.push({ payload: src[aux] === buttons[i] });\nout.push({ payload: name(src[1]) }, { payload: name(src[2]) });\nreturn out;",
  "outputs": 10,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 980,
  "y": 700,
  "wires": [
   [
    "mcs8m.bdash.a1led1"
   ],
   [
    "mcs8m.bdash.a1led2"
   ],
   [
    "mcs8m.bdash.a1led3"
   ],
   [
    "mcs8m.bdash.a1led4"
   ],
   [
    "mcs8m.bdash.a2led1"
   ],
   [
    "mcs8m.bdash.a2led2"
   ],
   [
    "mcs8m.bdash.a2led3"
   ],
   [
    "mcs8m.bdash.a2led4"
   ],
   [
    "mcs8m.bdash.a1active"
   ],
   [
    "mcs8m.bdash.a2active"
   ]
  ]
 },
