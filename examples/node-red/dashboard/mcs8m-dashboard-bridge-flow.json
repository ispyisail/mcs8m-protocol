 {
  "id": "mcs8m.bdash.state",
  "z": "mcs8m.bdash.tab",
  "type": "function",
  "name": "Bridge state to dashboard",
  "outputs": 5,
  "timeout": 0,
  "noerr": 0,
  "initialize": "",
  "finalize": "",
  "libs": [],
  "x": 740,
  "y": 760,
  "wires": [
   [
    "mcs8m.bdash.leds"
   ],
   [
    "mcs8m.bdash.leds"
   ],
   [
    "mcs8m.bdash.loopwarn"
   ],
   [
    "mcs8m.bdash.vmixmode"
   ],
   [
    "mcs8m.bdash.obsmode"
   ]
  ],
  "func": "// Outputs: 1 Aux 1 source, 2 Aux 2 source (to the LED controller), 3 loop warning text,\n// 4 vMix mode, 5 OBS mode (to the dropdowns).\nconst s = msg.payload;\nif (msg.statusCode !== 200 || !s || typeof s !== 'object') { node.status({ fill: 'red', shape: 'ring', text: 'bridge not reachable' }); return null; }\nif (s.connected) flow.set('last_response_time', Date.now());       // drives Switcher Status (watchdog)\nnode.status({ fill: s.connected ? 'green' : 'yellow', shape: 'dot',\n              text: `PGM ${s.program} PST ${s.preset} AUX ${s.aux1}/${s.aux2}` + (s.connected ? '' : ' (switcher not responding)') });\nconst last = context.get('last') || {};\nconst changed = (k, v) => { const j = JSON.stringify(v === undefined ? null : v); if (k in last && last[k] === j) return false; last[k] = j; return true; };\n// names: the bridge's 'inputs' are the one place to set them; EDIT SETTINGS HERE only fills gaps\nif (s.names && Object.keys(s.names).length) flow.set('source_names', Object.assign({}, flow.get('source_names') || {}, s.names));\nconst out = [null, null, null, null, null];\nif (s.aux1 != null && changed('aux1', s.aux1)) out[0] = { payload: { aux: 1, source: s.aux1 } };\nif (s.aux2 != null && changed('aux2', s.aux2)) out[1] = { payload: { aux: 2, source: s.aux2 } };\nif (changed('loop', s.loop_warning)) out[2] = { payload: s.loop_warning || 'No video loop' , color: s.loop_warning ? 'red' : 'green' };\nconst apps = s.apps || {};\nif (changed('vmix', apps.vmix && apps.vmix.mode)) out[3] = { payload: apps.vmix ? apps.vmix.mode : 'off' };\nif (changed('obs', apps.obs && apps.obs.mode)) out[4] = { payload: apps.obs ? apps.obs.mode : 'off' };\ncontext.set('last', last);\nreturn out;"
 },
