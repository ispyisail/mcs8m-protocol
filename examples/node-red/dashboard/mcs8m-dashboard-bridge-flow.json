  "func": "// 202 = sent; 409 = refused by the bridge (e.g. it would make a video loop) - show why.\nif (msg.statusCode === 202) { node.status({ fill: 'green', shape: 'dot', text: 'sent' }); return null; }\nconst why = (msg.payload && msg.payload.error) || ('HTTP ' + msg.statusCode);\nnode.status({ fill: 'red', shape: 'ring', text: why.slice(0, 60) });\nnode.warn(why);\nreturn null;"
 },
