 },
 "transport": {
  "interface": "RS-232C",
  "connector": "REMOTE, 9-pin D-sub, rear panel (DTE pinout: pin 2 RxD in, pin 3 TxD out, pin 5 GND)",
  "cable": "null-modem (TxD/RxD crossed); only TxD, RxD, GND used",
  "baud": 38400,
  "data_bits": 8,
  "parity": "none",
  "stop_bits": 1,
  "flow_control": "none",
  "enable_on_switcher": "Setup > System > highlight 'Back' > press V3 knob > For Services > Serial Cmd Group = Rem 1, then save and restart with Startup Define. Off from the factory; without it the switcher ignores all frames silently. Never select FACT.",
  "encoding": "binary frames; no ASCII, no line endings"
 },
 "framing": {
  "layout": [
   {
    "field": "DEL",
    "bytes": 1,
    "value": "0x01"
   },
   {
    "field": "STX",
    "bytes": 1,
    "value": "0x02"
   },
   {
    "field": "BC",
    "bytes": 2,
    "endian": "big",
    "meaning": "number of bytes from PID through the last MSG byte (= 5 + len(MSG))",
    "erratum": "the manual says little-endian; that is wrong (verified)"
   },
   {
    "field": "PID",
    "bytes": 1,
    "values": {
     "video": "0x01",
     "audio": "0x02"
    }
   },
   {
    "field": "FID",
    "bytes": 1,
    "value": "0x50",
    "note": "replies from the switcher also carry 0x50"
   },
   {
    "field": "TID",
    "bytes": 1,
    "values": {
     "video": "0x20",
     "audio": "0x30"
    }
   },
   {
    "field": "ARQ",
    "bytes": 1,
    "value": "0x00"
   },
   {
    "field": "ART",
    "bytes": 1,
    "value": "0x00"
   },
   {
    "field": "MSG",
    "bytes": "variable",
    "see": "families"
   },
   {
    "field": "CS",
    "bytes": 1,
    "meaning": "checksum"
   },
   {
    "field": "ETX",
    "bytes": 1,
    "value": "0x03"
   }
  ],
  "frame_length": "BC + 6",
  "checksum": {
   "rule": "sum of all bytes from BC (both bytes) through CS, modulo 256, equals 0",
   "compute": "CS = (-sum(BC_hi, BC_lo, PID ... last MSG byte)) & 0xFF"
  },
  "parsing": [
   "Find frame boundaries with BC. 0x03 also appears inside frames (PROT, EFF 0x03 = Aux2, data, checksums), so never split on ETX.",
   "Resync by dropping one byte when BC is implausible (<5 or >512), ETX is missing, or the checksum fails.",
   "A lone 0x04 outside a frame is an ACK (after audio writes)."
  ]
 },
 "families": {
  "video": {
   "pid": "0x01",
   "tid": "0x20",
   "msg": [
    "PROT (always 0x03)",
    "count (number of bytes that follow: EFF + CMD + args)",
    "EFF (section)",
    "CMD",
    "args..."
   ],
   "read": "CMD with the high bit clear (0x00-0x7F)",
   "write": "CMD with the high bit set (CMD | 0x80)",
   "answer": "a full frame in the write layout (CMD | 0x80) carrying the current value",
   "warning": "the read/write bit is the OPPOSITE of the audio family"
  },
  "audio": {
   "pid": "0x02",
   "tid": "0x30",
   "msg": [
    "CMD",
    "data..."
   ],
   "read": "status request: CMD | 0x80, with the same data bytes as a write (the value byte is ignored; send 0x00)",
   "write": "CMD with the high bit clear",
   "answer": "reads: a full frame with CMD (high bit clear) and the current data; writes: a lone 0x04 ACK byte",
   "warning": "the read/write bit is the OPPOSITE of the video family"
  }
 },
